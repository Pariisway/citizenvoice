rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function role() {
      return isSignedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : 'guest';
    }

    function isModeratorOrAbove() {
      return role() in ['moderator', 'administrator', 'community_leader'];
    }

    function isAdmin() {
      return role() == 'administrator';
    }

    // Anonymous accounts flagged by the burst-posting guard (see
    // functions/src/moderation/rateLimitGuard.ts) are blocked from further
    // writes until a moderator clears the flag.
    function isNotSuspended() {
      return !exists(/databases/$(database)/documents/suspendedAuthors/$(request.auth.uid));
    }

    // Membership: true once the anonymous session has been upgraded to a
    // real account (email/password or Google — see QuickAccountPrompt.tsx,
    // which links credentials onto the SAME uid rather than creating a new
    // one). `sign_in_provider` comes straight from the ID token, so this
    // needs no extra Firestore read. Voice chat and discussion are
    // member-only; browsing and reading are open to everyone.
    function isMember() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // ---------- Public, read-only civic data ----------
    // Representatives, bills, meetings, districts: anyone (including
    // anonymous/guest users) can read. Only moderators/admins can write —
    // civic facts are curated, not crowd-edited, to protect neutrality.
    match /representatives/{repId} {
      allow read: if true;
      allow write: if isModeratorOrAbove();
    }

    match /bills/{billId} {
      allow read: if true;
      allow write: if isModeratorOrAbove();
    }

    match /meetings/{meetingId} {
      allow read: if true;
      allow write: if isModeratorOrAbove();
    }

    match /cities/{cityId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Server-populated cache from the findMyRepresentatives Cloud Function.
    // Never written directly by clients.
    match /districtLookupCache/{cacheKey} {
      allow read: if true;
      allow write: if false; // Cloud Functions use the Admin SDK, which bypasses rules.
    }

    // ---------- Citizen Chat videos ----------
    // Public, ad-supported video feed. Anyone can watch, no sign-in
    // required. Only admins/moderators can publish or remove a video —
    // the actual file upload is gated separately by storage.rules.
    match /videos/{videoId} {
      allow read: if true;
      allow create, update, delete: if isModeratorOrAbove();
    }

    // ---------- Civic Academy ----------
    // Free to watch, no sign-in required. Lessons are curated content
    // (admin/moderator only); progress is tracked per anonymous identity
    // and only that identity can read/write its own progress doc.
    match /lessons/{lessonId} {
      allow read: if true;
      allow create, update, delete: if isModeratorOrAbove();
    }
    match /lessonProgress/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if isSignedIn() && request.auth.uid == uid;
    }

    // ---------- Editable site content ----------
    // Homepage copy, editable live from /admin/homepage. Public read
    // (this is the actual page content), moderator+ write only.
    match /siteContent/{docId} {
      allow read: if true;
      allow write: if isModeratorOrAbove();
    }

    // ---------- Community Bill Lab ----------
    // Proposals are only ever created by the submitProposal Cloud
    // Function (Admin SDK bypasses rules) — this re-verifies Academy
    // completion server-side, which a client-side check alone can't
    // enforce. Clients can read active/passed proposals and (as
    // moderators) update status during review.
    match /proposals/{proposalId} {
      allow read: if true;
      allow create: if false;
      allow update: if isModeratorOrAbove();
      // Authors can delete their own proposal (e.g. from their
      // dashboard), moderators+ can delete any.
      allow delete: if isModeratorOrAbove()
                    || (isSignedIn() && resource.data.authorUid == request.auth.uid);
    }

    match /proposalComments/{commentId} {
      allow read: if true;
      allow create: if isMember() && isNotSuspended()
                    && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.authorName is string
                    && request.resource.data.authorName.size() > 0;
      allow update, delete: if isSignedIn()
                    && (resource.data.authorId == request.auth.uid || isModeratorOrAbove());
    }

    // Vote records are only ever created by the upvoteProposal Cloud
    // Function, which also increments the denormalized counter on the
    // proposal doc — keeps both in sync and prevents double-voting via
    // direct client writes. Petition-signing stays open to anonymous
    // visitors on purpose — it's the on-ramp into membership, not a
    // member-only action.
    //
    // These now hold real PII (full legal name + email — see
    // upvoteProposal.ts) so they can eventually back a real petition
    // handed to a legislator. Only the signer themselves and
    // moderators+ (for compiling/exporting signatures) can read them —
    // NOT anyone signed in, unlike most other collections here.
    match /proposalUpvotes/{voteId} {
      allow read: if isModeratorOrAbove() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    // ---------- Voice room presence ----------
    // Written directly by the client on join/leave — not security
    // sensitive (just "who's in the room right now"), but scoped so
    // people can only write their own presence doc.
    match /voiceRoomPresence/{docId} {
      allow read: if true;
      // Community rooms are open to everyone; proposal (bill) rooms are
      // member-only — differentiated by the roomType field the client
      // sets (see CommunityVoiceRoom.tsx vs ProposalVoiceRoom.tsx). The
      // real gate for proposal rooms is generateAgoraToken.ts; this is
      // defense in depth.
      allow create: if isSignedIn() && isNotSuspended()
                    && request.resource.data.uid == request.auth.uid
                    && (
                         (('roomType' in request.resource.data) && request.resource.data.roomType == 'community')
                         || isMember()
                       );
      // Moderators can remove someone from a room's live participant list
      // (see /admin/community-moderation) in addition to people removing
      // their own presence on leave.
      allow delete: if isSignedIn()
                    && (resource.data.uid == request.auth.uid || isModeratorOrAbove());
      allow update: if false;
    }

    // ---------- Community Chat ----------
    // The community/city/county directory shown at /community-chat.
    // Curated like representatives/videos — anyone can read, only
    // moderators+ manage the list (see /admin/communities).
    match /communities/{communityId} {
      allow read: if true;
      allow create, update, delete: if isModeratorOrAbove();
    }

    // Text messages inside a community room. Open to everyone — Community
    // Chat has no membership requirement, only bill discussion does.
    match /communityMessages/{messageId} {
      allow read: if true;
      allow create: if isSignedIn() && isNotSuspended()
                    && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.authorName is string
                    && request.resource.data.authorName.size() > 0;
      allow update, delete: if isSignedIn()
                    && (resource.data.authorId == request.auth.uid || isModeratorOrAbove());
    }

    // ---------- Anonymous identity ----------
    // Every visitor is silently signed in via Firebase Anonymous Auth
    // (see lib/useAnonymousIdentity.ts) — no email/password, no visible
    // sign-up screen. This doc just stores their chosen display name.
    match /anonymousProfiles/{uid} {
      allow read: if true; // display names are public by nature
      allow write: if isSignedIn() && request.auth.uid == uid
                   && request.resource.data.displayName is string
                   && request.resource.data.displayName.size() <= 40;
    }

    // Written only by the rateLimitGuard Cloud Function (Admin SDK bypasses
    // rules); moderators can read to review, nobody can write from the client.
    match /suspendedAuthors/{uid} {
      allow read: if isModeratorOrAbove();
      allow write: if false;
    }

    // ---------- User-generated content ----------
    // Comments and questions: any signed-in user (anonymous auth counts —
    // request.auth is populated) can create, as long as they're not
    // currently suspended and include a display name. Only the author or a
    // moderator can edit/delete.
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn() && isNotSuspended()
                    && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.authorName is string
                    && request.resource.data.authorName.size() > 0;
      allow update, delete: if isSignedIn()
                    && (resource.data.authorId == request.auth.uid || isModeratorOrAbove());
    }

    match /questions/{questionId} {
      allow read: if true;
      allow create: if isSignedIn() && isNotSuspended()
                    && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.authorName is string
                    && request.resource.data.authorName.size() > 0;
      allow update, delete: if isSignedIn()
                    && (resource.data.authorId == request.auth.uid || isModeratorOrAbove());
    }

    // ---------- Voice rooms ----------
    // Room metadata (topic, host, active speaker list) lives in Firestore;
    // actual audio flows through Agora and never touches Firestore. Any
    // non-suspended signed-in (including anonymous) user can raise a hand;
    // actually speaking additionally requires a display name, enforced in
    // generateAgoraToken.ts before a speaker token is issued.
    match /voiceRooms/{roomId} {
      allow read: if true;
      allow create: if isModeratorOrAbove();
      allow update: if isModeratorOrAbove()
                    || (isSignedIn() && isNotSuspended()
                          && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['raisedHands']));
      allow delete: if isModeratorOrAbove();
    }

    // ---------- Users ----------
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      // Users can edit their own profile fields, but never their own `role`.
      allow update: if isSignedIn() && request.auth.uid == userId
                    && request.resource.data.role == resource.data.role
                    || isAdmin();
      allow delete: if isAdmin();
    }

    // ---------- Moderation ----------
    match /flags/{flagId} {
      allow read: if isModeratorOrAbove();
      allow create: if isSignedIn();
      allow update, delete: if isModeratorOrAbove();
    }

    // ---------- Default deny ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
