rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function role() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdminOrModerator() {
      return request.auth != null && role() in ['administrator', 'moderator'];
    }

    match /community-videos/{fileName} {
      allow read: if true;
      allow write: if isAdminOrModerator()
                   && request.resource.size < 500 * 1024 * 1024
                   && request.resource.contentType.matches('video/.*');
    }

    match /representative-photos/{fileName} {
      allow read: if true;
      allow write: if isAdminOrModerator()
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Community Chat room cover photos — admin/moderator only.
    match /community-photos/{fileName} {
      allow read: if true;
      allow write: if isAdminOrModerator()
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /academy-videos/{fileName} {
      allow read: if true;
      allow write: if isAdminOrModerator()
                   && request.resource.size < 500 * 1024 * 1024
                   && request.resource.contentType.matches('video/.*');
    }

    match /proposal-photos/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Quick-account profile pictures (see QuickAccountPrompt.tsx). Path is
    // scoped by uid so people can only write their own photo.
    match /profile-photos/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
